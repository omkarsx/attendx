# Database Connections (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/attendx?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/attendx?sslmode=require"

# Google OAuth 2.0 Provider
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Auth / Session Secret (JWE/JWT signing key)
AUTH_SECRET="your-auth-secret"

# Server-Side Administrator Emails Allowlist (comma-separated)
ADMIN_EMAILS="admin@attendx.edu,hod.entc@attendx.edu"
